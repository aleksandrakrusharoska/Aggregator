# Копирај го овој фајл како .env и пополни ги вредностите
DATABASE_URL=postgresql+psycopg2://aggregator:aggregator@localhost:5432/ad_aggregator
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Scraping
SCRAPE_INTERVAL_MINUTES=30
SCRAPE_USER_AGENT=AdAggregatorBot/1.0 (diploma-project; contact@example.com)

# ML
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
DEDUP_SIMILARITY_THRESHOLD=0.92
PRICE_ANOMALY_ZSCORE=2.5

# LangChain / LLM (опционално, за нормализација на описи)
ANTHROPIC_API_KEY=
